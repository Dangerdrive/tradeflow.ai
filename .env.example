# ============================================================
# TradeFlow — exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA versione o `.env` real.
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Banco de dados relacional ---
# SQLite (padrão para dev):
DATABASE_URL=sqlite:///./data/tradeflow.db
# PostgreSQL (exemplo):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tradeflow

# --- Banco vetorial (ChromaDB) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Aplicação ---
APP_NAME=TradeFlow
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
ALLOWED_DOCUMENT_EXTENSIONS=.pdf

# --- API REST ---
# Chave exigida no header X-API-Key. Vazia = autenticação desabilitada (dev).
API_KEY=
# Rate limit no formato slowapi (ex.: "10/minute").
API_RATE_LIMIT=10/minute
